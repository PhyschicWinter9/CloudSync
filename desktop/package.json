{
  "name": "claudesync-desktop",
  "version": "0.1.1",
  "description": "ClaudeSync desktop app: automatic backup and restore for everything Claude Code stores on your machine",
  "private": true,
  "author": "ClaudeSync contributors",
  "repository": "https://github.com/PhyschicWinter9/CloudSync",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "generate-icons": "node scripts/generate-icons.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.claudesync.app",
    "productName": "ClaudeSync",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": ["AppImage"]
    }
  }
}
